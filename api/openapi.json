          }
        },
        "required": [
          "summary",
          "monitors"
        ],
        "title": "DashboardOut",
        "type": "object"
      },
      "EmailIn": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailIn",
        "type": "object"
      },
      "LoginEventOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "user_agent": {
            "title": "User Agent",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "ip",
          "user_agent",
          "created_at"
        ],
        "title": "LoginEventOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MonitorRowOut": {
        "properties": {
          "down_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Down Minutes"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "last_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
