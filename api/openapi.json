{
  "components": {
    "schemas": {
      "CodeIn": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeIn",
        "type": "object"
      },
      "DashboardOut": {
        "properties": {
          "monitors": {
            "items": {
              "$ref": "#/components/schemas/MonitorRowOut"
