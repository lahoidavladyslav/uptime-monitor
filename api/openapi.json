            "title": "Name",
            "type": "string"
          },
          "spark": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Spark",
            "type": "array"
          },
