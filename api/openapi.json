            "enum": [
              "up",
              "down",
              "unknown",
              "maintenance",
              "paused"
            ],
            "title": "Status",
            "type": "string"
          },
          "uptime_24h": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
