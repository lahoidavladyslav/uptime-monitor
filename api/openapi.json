    "securitySchemes": {
      "CsrfProtect": {
        "in": "header",
        "name": "X-CSRFToken",
        "type": "apiKey"
      },
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
