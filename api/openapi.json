          },
          "maintenance": {
            "title": "Maintenance",
            "type": "integer"
          },
          "open_incidents": {
            "title": "Open Incidents",
            "type": "integer"
          },
          "paused": {
            "title": "Paused",
            "type": "integer"
          },
          "unknown": {
            "title": "Unknown",
            "type": "integer"
          },
          "up": {
            "title": "Up",
            "type": "integer"
          }
