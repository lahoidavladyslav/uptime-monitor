# Copy to .env.prod and fill in. Never commit the real file (.env.* is git-ignored, this example is whitelisted).
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=status.example.com
CSRF_TRUSTED_ORIGINS=https://status.example.com
# Where the SPA is served: confirmation and password-reset emails sent by the API link here.
FRONTEND_URL=https://status.example.com
# Where Django-rendered pages (public status pages, subscribe/unsubscribe links in mails) are reachable.
# Defaults to FRONTEND_URL in production (nginx serves both on one origin).
SITE_URL=https://status.example.com
# 0 only for a local trial over plain HTTP
HTTPS=1

POSTGRES_DB=uptime
POSTGRES_USER=uptime
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://uptime:change-me@db:5432/uptime

# Celery broker and cache live in separate Redis databases
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=uptime@example.com

# optional: empty METRICS_TOKEN disables /metrics/
METRICS_TOKEN=
SENTRY_DSN=
# json (default in production) or plain
LOG_FORMAT=json
LOG_LEVEL=INFO
WEB_CONCURRENCY=3
HTTP_PORT=80
